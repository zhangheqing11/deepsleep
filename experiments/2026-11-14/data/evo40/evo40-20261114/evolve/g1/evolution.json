  "candidates": [
    {
      "id": "c1",
      "summary": "用入睡过程和对照场景提前区分路径，避免按规律作息或情绪线索过早锚定。",
      "changes": [
        {
          "id": "c1-questioning_strategy-1",
          "op": "add",
          "section": "questioning_strategy",
          "before": null,
          "after": "首轮记下常规作息后，下一问用“昨晚上床后没睡着的那段时间，你主要在做什么或想什么？”，再按回答一次追问一个路径对照场景，不把上床时间当睡着时间，也不凭笼统晚睡就归入 P1。",
          "reason": "反复确认作息挤占了关键提问，入睡前行为与思绪缺失时，正确路径权重持续偏低。",
          "criticality_rule": "low",
          "criticality_self": "medium",
          "criticality": "medium"
        },
        {
          "id": "c1-path_discrimination-2",
          "op": "modify",
          "section": "path_discrimination",
          "before": "P2 与 P3 主要看躺下后脑子里有没有内容，换地方是否好转只作辅助。",
          "after": "区分 P2 与 P3 时，分次追问困着上床后是否反而清醒、以往同一晚换到床外是否更易睡着，以及清醒时念头的内容与出现先后，地点相关的清醒支持 P2、持续复盘或担忧妨碍入睡支持 P3，不因脑中有内容就排除 P2。",
          "reason": "仅凭有无思绪容易误分，床内外困意和念头出现先后的对照能补足鉴别证据。",
          "criticality_rule": "medium",
          "criticality_self": "medium",
          "criticality": "medium"
        },
        {
          "id": "c1-path_discrimination-3",
          "op": "add",
          "section": "path_discrimination",
          "before": null,
          "after": "晚睡原因未明时，先问最近不用手机的一晚是否仍到很晚才困，若停屏后易睡则追问平日刷屏是否推迟睡觉以核实 P5，若仍晚困或没有该对照经历则分次询问自由作息下能否睡好及是否轮班以核实 P4，未经历的情境记为未知且不以情绪线索替代路径证据。",
          "reason": "数字娱乐线索出现偏晚，节律线索常未问出，需要主动获取能纠正初始判断的对照。",
          "criticality_rule": "medium",
          "criticality_self": "medium",
          "criticality": "medium"
        }
