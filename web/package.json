{
  "name": "deepsleep-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "typecheck": "tsc --noEmit -p tsconfig.json",
