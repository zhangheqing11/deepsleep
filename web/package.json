{
  "name": "deepsleep-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:read-api": "node --test tests/read-api.test.mjs",
    "test:sw": "node --test tests/sw.test.mjs",
    "test:board": "node --test tests/board.test.mjs",
    "test:app": "node --test tests/app.test.mjs",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "preview:lan": "vite preview --host",
    "test:link": "node --test tests/devconsoleLink.test.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
