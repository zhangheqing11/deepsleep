# 复制为 web/.env.local 后按需修改；.env.local 不入库。

# 数据来源：mock = 前端本地模拟适配器（不需要后端）；http = 请求后端 API
VITE_API_ADAPTER=http

# API 基础地址。开发期保持 /api/v1，由 Vite 代理转发到下面的后端地址。
# 如果直连后端（需要后端开启 CORS），可写完整地址，例如 http://127.0.0.1:8000/api/v1
VITE_API_BASE_URL=/api/v1

# 开发代理的后端地址（待与后端确认协议、主机和端口）
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000
