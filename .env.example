# 本地演示登录：none 保持匿名联调；demo 启用单个演示账号（密码只存哈希）
API_AUTH_MODE=none
API_AUTH_USERNAME=demo
API_AUTH_PASSWORD_SHA256=
API_AUTH_TTL_S=28800
# Empty uses safety/config.yaml; ds_flash | jev | gemini_decision | startlux | mock
JUDGE_PROVIDER=
