# 进化后台配置（复制为 .env.local 后修改；.env.local 不提交）。

# 数据模式：mock | http | snapshot
#   mock     读 contracts/examples 正式示例 + src/fixtures 手写开发样例，页面全程标“模拟数据”
#   http     读后端只读接口（/demo/experiment、/runs/{id}、/evolutions/{id} 等，见 README“需要的后端接口”）
#   snapshot 回放包（尚未实现，选它会明确显示不可用）
# 不填时为 mock。填了不认识的值会直接报配置错误，不会悄悄退回 mock。
VITE_DATA_MODE=mock

# 接口基础地址；默认走开发代理 /api/v1。双机演示时由后端确认实际地址，不要写成 localhost。
# VITE_API_BASE_URL=/api/v1

# 开发代理目标（只影响 npm run dev / preview）
# VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000

# 轮询参数（毫秒，可不填）
# VITE_EXPERIMENT_POLL_MS=2000
# VITE_RUN_POLL_MS=1000
# VITE_REQUEST_TIMEOUT_MS=8000
